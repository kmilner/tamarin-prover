lemma both [right]:
  exists-trace "∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
*/
simplify
solve( Used( 'a' ) @ #i )
  case Use
  solve( State( 'a' ) ▶₀ #i )
    case SeedA
    solve( Used( 'b' ) @ #j )
      case Use
      solve( State( 'b' ) ▶₀ #j )
        case SeedB
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma both [left]:
  exists-trace "∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
*/
simplify
