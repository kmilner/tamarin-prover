  solve( State( 'a' ) ▶₀ #i )
    case SeedA
    solve( Used( 'b' ) @ #j )
      case Use
      solve( State( 'b' ) ▶₀ #j )
        case SeedB
        SOLVED // trace found
      qed
    qed
  qed
qed

