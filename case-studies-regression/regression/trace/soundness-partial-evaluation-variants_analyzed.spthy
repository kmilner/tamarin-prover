theory SoundnessPartialEvaluationVariants

begin

// Function signature and definition of the equational theory E

functions: c/1, d/1, fst/1, pair/2, snd/1
equations: d(c(x)) = x, fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

text{* the abstract state after partial evaluation contains 3 facts:

1. State( 'ok' )

2. Fr( ~z )

3. In( z )

This abstract state results in 2 refined multiset rewriting rules.
Note that the original number of multiset rewriting rules was 2.

*}

rule (modulo E) Seed:
   [ ] --> [ State( 'ok' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) UseModuloE___VARIANT_1___VARIANT_1:
   [ State( 'ok' ) ] --[ UsedModuloE( ), UsedImportedVariant( ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma e_variant_reachable:
  exists-trace "∃ #i. UsedModuloE( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (UsedModuloE( ) @ #i)"
*/
simplify
solve( State( 'ok' ) ▶₀ #i )
  case Seed
  SOLVED // trace found
qed

