              case c_fst
              step( solve( !KU( k ) @ #vk.2 ) )
                case c_fst
                step( solve( !KU( fst(x.1) ) @ #vk.2 ) )
                  case c_fst
                  step( solve( !KU( x ) @ #vk.3 ) )
                    case fresh
                    step( solve( !KU( ~x ) @ #vk.3 ) )
                      case fresh
                      step( solve( !KU( x.1 ) @ #vk.4 ) )
