theory UnrelatedEmptyFamily

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~n ) ] --[ A( ~n ) ]-> [ State( ~n ), Out( 'ok' ) ]

rule (modulo E) Finish:
   [ State( n ) ] --[ B( n ) ]-> [ ]

rule (modulo E) Dead:
   [ Fr( ~n ), In( diff(~n, 'known') ) ] --[ Dead( ) ]-> [ Out( 'bad' ) ]

restriction Impossible [right]:
  "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
  */

restriction Impossible [left]:
  "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
  */

restriction Unique [right]:
  "∀ n #i #j. ((A( n ) @ #i) ∧ (A( n ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ n #i #j. ((A( n ) @ #i) ∧ (A( n ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique [left]:
  "∀ n #i #j. ((A( n ) @ #i) ∧ (A( n ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ n #i #j. ((A( n ) @ #i) ∧ (A( n ) @ #j)) ⇒ (#i = #j)"
  */

restriction Order [right]:
  "∀ n #i. (B( n ) @ #i) ⇒ (∃ #j. (A( n ) @ #j) ∧ (#j < #i))"

  /*
  expanded formula:
  "∀ n #i. (B( n ) @ #i) ⇒ (∃ #j. (A( n ) @ #j) ∧ (#j < #i))"
  */

restriction Order [left]:
  "∀ n #i. (B( n ) @ #i) ⇒ (∃ #j. (A( n ) @ #j) ∧ (#j < #i))"

  /*
  expanded formula:
  "∀ n #i. (B( n ) @ #i) ⇒ (∃ #j. (A( n ) @ #j) ∧ (#j < #i))"
  */

lemma setup [right]:
  exists-trace "∃ n #i. A( n ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ n #i. (A( n ) @ #i)"
*/
simplify
SOLVED // trace found

