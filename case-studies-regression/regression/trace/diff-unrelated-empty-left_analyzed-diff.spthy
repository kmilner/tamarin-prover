  exists-trace "∃ n #i. A( n ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ n #i. (A( n ) @ #i)"
*/
simplify
SOLVED // trace found

lemma finish [right]:
  exists-trace "∃ n #i. B( n ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ n #i. (B( n ) @ #i)"
*/
simplify
solve( State( ~n ) ▶₀ #i )
  case Setup
  SOLVED // trace found
qed

lemma finish [left]:
  exists-trace "∃ n #i. B( n ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ n #i. (B( n ) @ #i)"
*/
simplify
solve( State( ~n ) ▶₀ #i )
  case Setup
  SOLVED // trace found
qed

lemma dead [right]:
  all-traces "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Dead( ) @ #i)"
*/
simplify
by contradiction /* from formulas */

lemma dead [left]:
  all-traces "∀ #i. (Dead( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Dead( ) @ #i)"
*/
simplify
by contradiction /* from formulas */

diffLemma D:
rule-equivalence
  case Rule_Dead
  backward-search
    case LHS
    step( simplify )
    by step( solve( DiffProtoDead( ) @ #i ) )
  next
    case RHS
    step( simplify )
    by step( contradiction /* from formulas */ )
  qed
next
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Setup
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Dead
      by step( contradiction /* impossible chain */ )
    next
      case Setup
      by step( contradiction /* impossible chain */ )
    qed
