    qed
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Setup
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_ok
        step( solve( !KU( 'ok' ) @ #vk ) )
          case coerce
          step( solve( !KD( 'ok' ) ▶₀ #vk ) )
            case Setup
            by step( contradiction /* impossible chain */ )
          qed
        next
          case pub
          MIRRORED
        qed
      qed
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Dead
      by step( contradiction /* from formulas */ )
    next
      case Setup
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_ok
        step( solve( !KU( 'ok' ) @ #vk ) )
          case coerce
          step( solve( !KD( 'ok' ) ▶₀ #vk ) )
            case Dead
            by step( contradiction /* impossible chain */ )
          next
            case Setup
            by step( contradiction /* impossible chain */ )
          qed
        next
          case pub
          MIRRORED
        qed
      qed
    qed
  qed
next
  case Rule_Finish
  backward-search
    case LHS
    step( simplify )
    step( solve( State( ~n ) ▶₀ #i ) )
      case Setup
      MIRRORED
    qed
  next
    case RHS
    step( simplify )
    step( solve( State( ~n ) ▶₀ #i ) )
      case Setup
      MIRRORED
    qed
  qed
next
  case Rule_Send
