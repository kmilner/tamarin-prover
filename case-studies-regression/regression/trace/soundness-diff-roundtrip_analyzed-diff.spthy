theory SoundnessDiffRoundtrip

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

macros: m( x ) =  x

rule (modulo E) Produce:
   [ ] --> [ F( ('a'++'b') ) ]

rule (modulo E) Consume:
   [ F( (x++y) ) ] --[ Choice( x, y ) ]-> [ Out( 'ok' ) ]

lemma source [left, sources]:
  all-traces "∀ x y #i. (Choice( x, y ) @ #i) ⇒ (⊤)"
/*
guarded formula characterizing all counter-examples:
"⊥"
*/
by contradiction /* from formulas */

restriction right_only [right]:
  "∀ x y #i. (Choice( x, y ) @ #i) ⇒ (x = 'b')"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Choice( x, y ) @ #i) ⇒ (x = 'b')"
  */

lemma witness [right]:
  exists-trace "∃ #i. Choice( 'b', 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Choice( 'b', 'a' ) @ #i)"
*/
simplify
solve( F( ('a'++'b') ) ▶₀ #i )
  case Produce
  SOLVED // trace found
qed

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Consume
  backward-search
    case LHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      MIRRORED
    next
      case Produce_case_2
      MIRRORED
    qed
  next
    case RHS
    step( simplify )
    step( solve( F( ('b'++y) ) ▶₀ #i ) )
      case Produce
      MIRRORED
    qed
  qed
next
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_snd
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_union
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( (x++y) ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( (x++y) ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Consume
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_ok
        step( solve( F( (x++y) ) ▶₀ #vr ) )
          case Produce_case_1
          step( solve( !KU( 'ok' ) @ #vk ) )
            case coerce
            step( solve( !KD( 'ok' ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        next
          case Produce_case_2
          step( solve( !KU( 'ok' ) @ #vk ) )
            case coerce
            step( solve( !KD( 'ok' ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        qed
      qed
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Consume
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_ok
        step( solve( F( ('b'++y) ) ▶₀ #vr ) )
          case Produce
          step( solve( !KU( 'ok' ) @ #vk ) )
            case coerce
            step( solve( !KD( 'ok' ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        qed
      qed
    qed
  qed
next
  case Rule_Produce
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Send
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
qed

/* All wellformedness checks were successful. */

