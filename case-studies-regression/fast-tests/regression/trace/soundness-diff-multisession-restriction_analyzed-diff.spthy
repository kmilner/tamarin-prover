  "∃ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ∧ (¬(#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i #j. (EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( EmitFor( k ) @ #i )
    case EmitFirst
    solve( First( k ) ▶₀ #i )
      case Init
      solve( EmitFor( ~k ) @ #j )
        case EmitSecond
        solve( Second( ~k ) ▶₀ #j )
          case Init
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

