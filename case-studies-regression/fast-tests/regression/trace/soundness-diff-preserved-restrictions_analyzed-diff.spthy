        qed
      qed
    next
      case Start
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case h
        step( solve( !KU( h(~k) ) @ #vk ) )
          case Start
          MIRRORED
        next
          case c_h
          by step( solve( !KU( ~k ) @ #vk.1 ) )
        qed
      qed
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Finish
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_ok
        step( solve( State( ~k ) ▶₀ #vr ) )
          case Finish
          by step( contradiction /* cyclic */ )
        next
          case Start
          step( solve( !KU( 'ok' ) @ #vk ) )
            case coerce
            step( solve( !KD( 'ok' ) ▶₀ #vk ) )
              case Finish
              by step( contradiction /* impossible chain */ )
            next
              case Start
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        qed
      qed
    next
      case Start
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case h
        step( solve( !KU( h(~m) ) @ #vk ) )
          case Start
          MIRRORED
        next
          case c_h
          by step( solve( !KU( ~m ) @ #vk.1 ) )
        qed
