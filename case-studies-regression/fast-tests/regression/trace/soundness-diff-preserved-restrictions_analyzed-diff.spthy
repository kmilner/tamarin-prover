theory SoundnessDiffPreservedRestrictions

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

/* looping facts with injective instances: State/1 */

/* looping facts with injective instances: State/1 */

/* looping facts with injective instances: State/1 */

/* looping facts with injective instances: State/1 */

rule (modulo E) Start:
   [ Fr( ~k ), Fr( ~m ) ]
  --[ Setup( ), Started( ~k ) ]->
   [ State( ~k ), Out( h(diff(~k, ~m)) ) ]

rule (modulo E) Finish:
   [ State( k ) ] --[ Finished( k ) ]-> [ State( k ), Out( 'ok' ) ]

restriction OneSetup [right]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneSetup [left]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneFinishPerSession [right]:
  "∀ k #i #j. ((Finished( k ) @ #i) ∧ (Finished( k ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ k #i #j. ((Finished( k ) @ #i) ∧ (Finished( k ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneFinishPerSession [left]:
  "∀ k #i #j. ((Finished( k ) @ #i) ∧ (Finished( k ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ k #i #j. ((Finished( k ) @ #i) ∧ (Finished( k ) @ #j)) ⇒ (#i = #j)"
  */

restriction FinishAfterStart [right]:
  "∀ k #i. (Finished( k ) @ #i) ⇒ (∃ #j. (Started( k ) @ #j) ∧ (#j < #i))"

  /*
  expanded formula:
  "∀ k #i. (Finished( k ) @ #i) ⇒ (∃ #j. (Started( k ) @ #j) ∧ (#j < #i))"
  */

restriction FinishAfterStart [left]:
  "∀ k #i. (Finished( k ) @ #i) ⇒ (∃ #j. (Started( k ) @ #j) ∧ (#j < #i))"

  /*
  expanded formula:
  "∀ k #i. (Finished( k ) @ #i) ⇒ (∃ #j. (Started( k ) @ #j) ∧ (#j < #i))"
  */

lemma completed [right]:
  exists-trace
  "∃ k #i #j. ((Started( k ) @ #i) ∧ (Finished( k ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i #j. (Started( k ) @ #i) ∧ (Finished( k ) @ #j) ∧ #i < #j"
*/
simplify
solve( State( ~k ) ▶₀ #j )
  case Start
  SOLVED // trace found
qed

lemma completed [left]:
  exists-trace
  "∃ k #i #j. ((Started( k ) @ #i) ∧ (Finished( k ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i #j. (Started( k ) @ #i) ∧ (Finished( k ) @ #j) ∧ #i < #j"
*/
simplify
solve( State( ~k ) ▶₀ #j )
  case Start
  SOLVED // trace found
qed

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Finish
      by step( contradiction /* impossible chain */ )
    next
      case Start
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Finish
      by step( contradiction /* impossible chain */ )
    next
      case Start
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_snd
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Finish
      by step( contradiction /* impossible chain */ )
    next
      case Start
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Finish
      by step( contradiction /* impossible chain */ )
    next
