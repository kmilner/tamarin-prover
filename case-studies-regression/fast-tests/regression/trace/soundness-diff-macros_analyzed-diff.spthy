theory SoundnessDiffMacros

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

macros: m( x ) =  x

rule (modulo E) EmitA:
   [ ] --[ A( 'a' ) ]-> [ ]

rule (modulo E) EmitB:
   [ ] --[ B( 'b' ) ]-> [ ]

rule (modulo E) FreshAlignment:
   [ ] --> [ Out( diff($x, 'right') ) ]

