theory InjectiveLast
begin

rule Create: [Fr(~id)] --[Cr(~id)]-> [S(~id), Once(~id)]
rule Use: [S(id), Once(id)] --[Use(id)]-> [S(id)]
rule Fin: [S(id)] --[Fin(id)]-> []

tactic: prem
presort: S
prio:
  regex "last\(#j\)"
prio:
  regex "▶₀ #j"

// Both Fin variables can denote the same event. Induction introduces last
// internally; the input formula does not use that internal atom.
lemma induction_counterexample [use_induction, heuristic={prem}]:
  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
    & not (Ex #u. Use(id)@u) ==> F"
lemma direct_counterexample:
  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
    & not (Ex #u. Use(id)@u) ==> F"
lemma witness: exists-trace
  "Ex id #i #j. Cr(id)@i & Fin(id)@j & #i < #j & not (Ex #u. Use(id)@u)"

// A counterexample requires distinct Fin nodes. Merging them must expose the
// contradictory disequality to the existing formula simplifier.
lemma distinct_finals_impossible [use_induction, heuristic={prem}]:
  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
    ==> #j=#k"

// The merge requires an edge ending at the last node. An earlier use can
// consume and reproduce the state before Fin consumes its successor.
lemma used_witness: exists-trace
  "Ex id #i #j #k. Cr(id)@i & Use(id)@j & Fin(id)@k & #i < #j & #j < #k"

end
