theory SoundnessDHProductsOutsideExponents
begin

builtins: diffie-hellman, hashing

// Products outside exponents are read modulo AC only, so x = 'a' and
// y = inv('a') do not make x*y equal to 1. Each of these lemmas is false,
// and each rule must be rejected: top-level and nested action products and
// a conclusion product.
rule Product:
  [ In(x), In(y) ] --[ Product(x*y) ]-> []

rule NestedProduct:
  [ In(x), In(y) ] --[ NestedProduct(h(x*y)) ]-> []

rule StoreProduct:
  [ In(x), In(y) ] --> [ Stored(x*y) ]

rule UseUnit:
  [ Stored(1) ] --[ UsedUnit() ]-> []

// A product in an exponent is normalised by variant computation and is
// supported; this rule must not be reported.
rule Power:
  [ In(x), In(y) ] --[ Power('g'^(x*y)) ]-> []

lemma product_unit_never: "All #i. Product(1)@i ==> F"
lemma nested_unit_never: "All #i. NestedProduct(h(1))@i ==> F"
lemma stored_unit_never: "All #i. UsedUnit()@i ==> F"
lemma power_neutral_exists: exists-trace "Ex #i. Power('g')@i"

end
